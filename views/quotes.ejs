<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Quote Cluster</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/quotes">Quotes</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/quotes/grouped">Grouped</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="hero-section bg-primary text-white text-center py-5">
    <div class="container">
      <h1 class="display-4">Quotes</h1>
      <p class="lead">browse through a collection of quotes</p>
    </div>
  </div>

  <div class="container mt-4">
    <div class="row">
      <div class="col-md-10 offset-md-1">
        <div id="content">
          <!-- quotes rendered here -->
        </div>
        <div class="text-center mt-3">
          <button class="btn btn-primary" id="load-more">Load More</button>
        </div>
      </div>
    </div>
  </div>

  <footer class="text-center py-4 bg-light border-top">
    <small class="text-muted">built for ce2000 · quote data from <a href="https://type.fit" target="_blank">type.fit</a></small>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
  <script src="/js/quotes.js"></script>
</body>
</html>
